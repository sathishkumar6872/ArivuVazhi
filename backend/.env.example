PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/arivuvazhi?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32+
ENCRYPTION_KEY=
# Required in production (base64 of 32 bytes). Use the SAME value locally when the local backend
# shares the production database (e.g. to sign in with ChatGPT), or saved tokens cannot be read.

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
ADMIN_PORTAL_URL=http://localhost:3001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local/demo only. Never set true in production.
ALLOW_DEMO_SEED=false

# Production requires a strong non-default ADMIN_PASSWORD (min 8). Local falls back to demo values.
ADMIN_EMAIL=admin@arivuvazhi.in
ADMIN_PASSWORD=Admin@12345
STUDENT_EMAIL=anitha@arivuvazhi.in
STUDENT_PASSWORD=Student@12345

# Daily personal mock sets are generated at 02:00 IST (and right after onboarding).
# Instances share a DB lease, so only one runs the job; "off" disables the schedule.
DAILY_MOCK_JOB=on
DAILY_MOCK_ACTIVE_DAYS=14
# 0 = full exam pattern (e.g. 200 questions). Set a number to cap every daily mock.
DAILY_MOCK_MAX_QUESTIONS=0
# AI calls in flight at once while building one student's mock.
DAILY_MOCK_CONCURRENCY=4
# Lets an external cron call the internal job routes (header x-cron-secret). Empty = disabled.
#   02:55 IST  POST /api/v1/internal/jobs/daily-mocks
#   03:00 IST  POST /api/v1/internal/jobs/current-affairs
CRON_SECRET=

# Daily current affairs at 03:00 IST for yesterday's news, then 2 months of the 18-month archive
# and practice questions from new items. "off" disables the in-process schedule.
CURRENT_AFFAIRS_JOB=on

# Public URL of this API (used for the Google Drive OAuth redirect URI).
# Local: http://localhost:4000  ·  Render: https://<your-service>.onrender.com
PUBLIC_API_URL=http://localhost:4000
# Google Drive OAuth Client ID / Secret are NOT env vars: set them in Admin → Settings · Storage
# (stored AES-256-GCM encrypted with the encryption key).
