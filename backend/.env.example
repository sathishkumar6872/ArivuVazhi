PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/arivuvazhi?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32+
ENCRYPTION_KEY=
# Required in production (base64 of 32 bytes). Local can omit and derive from JWT.

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
ADMIN_PORTAL_URL=http://localhost:3001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local/demo only. Never set true in production.
ALLOW_DEMO_SEED=false

# Production requires strong non-default ADMIN_PASSWORD (min 12). Local falls back to demo values.
